<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Meitou.local.props" Condition="Exists('Meitou.local.props')" />
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>CraftCrit-Meitou</AssemblyName>
    <RootNamespace>CraftCrit.Meitou</RootNamespace>
    <Version>0.1.3</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Nested test outputs must not become assembly candidates for the mod. Explicit client references always win. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;artifacts/**</DefaultItemExcludes>
    <AssemblySearchPaths>{HintPathFromItem};$(AssemblySearchPaths)</AssemblySearchPaths>
    <!-- Keep this baseline when updating the running client: one older-reference DLL can bind to newer game assemblies. -->
    <MeitouBaselineVersion>0.20.1</MeitouBaselineVersion>
    <MeitouDirectory Condition="'$(MeitouDirectory)' == ''">$(MSBuildThisFileDirectory)artifacts/meitou/$(MeitouBaselineVersion)</MeitouDirectory>
  </PropertyGroup>

  <!-- The game supplies these assemblies at runtime; never ship them with the mod. -->
  <ItemGroup>
    <Reference Include="MeitouClient" HintPath="$(MeitouDirectory)/MeitouClient.dll" Private="false" />
    <Reference Include="Meitou.Simulation" HintPath="$(MeitouDirectory)/Meitou.Simulation.dll" Private="false" />
    <Reference Include="Meitou.Data" HintPath="$(MeitouDirectory)/Meitou.Data.dll" Private="false" />
    <Reference Include="Meitou.Core" HintPath="$(MeitouDirectory)/Meitou.Core.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(MeitouDirectory)/0Harmony.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="meitou.json;CraftCrit-Meitou.mod" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckMeitouReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'%(Reference.HintPath)' != '' and !Exists('%(Reference.HintPath)')"
           Text="Missing Meitou reference: %(Reference.HintPath). Set MeitouDirectory to the official $(MeitouBaselineVersion) release folder (the oldest supported client); see README.md." />
    <GetAssemblyIdentity AssemblyFiles="$(MeitouDirectory)/MeitouClient.dll;$(MeitouDirectory)/Meitou.Simulation.dll;$(MeitouDirectory)/Meitou.Data.dll;$(MeitouDirectory)/Meitou.Core.dll">
      <Output TaskParameter="Assemblies" ItemName="_MeitouBaselineAssemblies" />
    </GetAssemblyIdentity>
    <Error Condition="'%(_MeitouBaselineAssemblies.Version)' != '$(MeitouBaselineVersion).0'"
           Text="%(_MeitouBaselineAssemblies.Identity) has version %(_MeitouBaselineAssemblies.Version). Build CraftCrit against the official $(MeitouBaselineVersion) assemblies to preserve the gameVersion minimum; use MeitouRuntimeDirectory for newer-client checks." />
  </Target>
</Project>

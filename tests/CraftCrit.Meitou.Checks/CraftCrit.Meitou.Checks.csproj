<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../Meitou.local.props" Condition="Exists('../../Meitou.local.props')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The harness runs against real game assemblies, with no Kenshi assets or test packages. -->
    <MeitouDirectory Condition="'$(MeitouDirectory)' == ''">$(MSBuildThisFileDirectory)../../artifacts/meitou/0.20.1</MeitouDirectory>
    <!-- Compile the harness against each tested client while the mod stays built against the oldest supported release. -->
    <MeitouRuntimeDirectory Condition="'$(MeitouRuntimeDirectory)' == ''">$(MeitouDirectory)</MeitouRuntimeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../CraftCrit-Meitou.csproj" ReferenceOutputAssembly="false" />
    <Reference Include="$(MeitouRuntimeDirectory)/*.dll"
               Exclude="$(MeitouRuntimeDirectory)/System.*.dll;$(MeitouRuntimeDirectory)/Microsoft.*.dll;$(MeitouRuntimeDirectory)/mscorlib.dll;$(MeitouRuntimeDirectory)/netstandard.dll;$(MeitouRuntimeDirectory)/WindowsBase.dll" />
    <None Include="../../bin/$(Configuration)/$(TargetFramework)/CraftCrit-Meitou.dll;../../meitou.json;../../CraftCrit-Meitou.mod"
          Link="Mod/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
